PORT=5000
NODE_ENV=development
JWT_SECRET=ai-saas-production-super-secret-key-2026

# ==========================================
# 🧠 LLM API KEYS (Google Gemini / OpenAI)
# ==========================================
# Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# 🍃 MONGODB DATABASE CONFIGURATION
# ==========================================
# Cloud (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/nexusai?retryWrites=true&w=majority
# Local MongoDB: mongodb://127.0.0.1:27017/nexusai
# (If left empty, system runs on persistent local database)
MONGODB_URI=
